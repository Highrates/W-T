# App
NODE_ENV=development
PORT=3000

# CORS (required outside development): comma-separated origins
# CORS_ORIGINS=https://staging.example.com,https://admin.example.com

# People ranking MV refresh (cron + on publish/spawn). Nest cron: sec min hour dom month dow
PEOPLE_STATS_CRON_ENABLED=true
PEOPLE_STATS_CRON=0 */15 * * * *

# WebSocket chat: ws://localhost:3000/chat?token=<access_jwt>

# Ops: promote existing OTP user to ADMIN (after first login)
# SEED_ADMIN_EMAIL=ops@example.com
# SEED_ADMIN_PHONE=+79991234567

# Database (docker-compose postgres)
DATABASE_URL=postgresql://walktalk:walktalk@localhost:5432/walktalk

# Redis
REDIS_URL=redis://localhost:6379

# JWT (refresh tokens stored hashed in DB; no separate refresh signing secret)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# OTP
OTP_TTL_SECONDS=300
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW_SECONDS=900
OTP_VERIFY_MAX_ATTEMPTS=5
OTP_VERIFY_ATTEMPT_WINDOW_SECONDS=900
OTP_VERIFY_LOCKOUT_BASE_SECONDS=60
OTP_VERIFY_LOCKOUT_MULTIPLIER=2
OTP_VERIFY_LOCKOUT_MAX_SECONDS=3600
OTP_VERIFY_LOCKOUT_LEVEL_TTL_SECONDS=86400

# SMS — Unimatrix (stub in dev when SMS_STUB=true)
SMS_STUB=true
UNIMATRIX_API_KEY=
UNIMATRIX_SENDER=

# Email — Gmail SMTP (App Password in SMTP_PASS)
EMAIL_STUB=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=timescale.25@gmail.com
SMTP_PASS=
EMAIL_FROM=timescale.25@gmail.com

# Yandex geo (existing module)
YANDEX_GEOSUGGEST_API_KEY=
YANDEX_GEOCODER_API_KEY=

# S3 / MinIO (local docker-compose)
S3_STUB=false
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/walktalk
S3_BUCKET=walktalk
S3_REGION=us-east-1
S3_ACCESS_KEY=walktalk
S3_SECRET_KEY=walktalksecret
# true = anonymous bucket read (local only). false = private + signed GET URLs.
S3_PUBLIC_READ=true
MINIO_PUBLIC_READ=true
S3_UPLOAD_URL_TTL_SECONDS=900
S3_READ_URL_TTL_SECONDS=3600
# Verify uploaded keys exist in bucket on publish/PATCH (HeadObject)
MEDIA_HEAD_OBJECT_VERIFY=false

# Reverse proxy: only these peer IPs may supply X-Forwarded-For (comma-separated)
# TRUSTED_PROXY_IPS=127.0.0.1,::1,10.0.0.1

# IP rate limits (Redis sliding window, atomic Lua)
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_GEO_MAX=60
RATE_LIMIT_GEO_WINDOW_SECONDS=60
RATE_LIMIT_REPORTS_MAX=10
RATE_LIMIT_REPORTS_WINDOW_SECONDS=300

# Push notifications (stub in dev; production = FCM HTTP v1)
PUSH_STUB=true
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
# FCM_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
